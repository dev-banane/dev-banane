---
import { monitors } from '../data/projects'
import { HISTORY_DAYS } from '../lib/uptime'

interface Props {
	project?: string
	variant?: 'compact' | 'full' | 'unified'
	heading?: string
}

const { project, variant = 'compact', heading } = Astro.props

const rows = project ? monitors.filter((m) => m.project === project) : monitors
const cells = Array.from({ length: HISTORY_DAYS }, (_, i) => i)
---

{
	variant === 'unified' && monitors.length > 0 && (
		<section class="uptime" data-variant="unified" data-endpoint="">
			<a class="uptime__all" href="/uptime">
				<div class="um__head">
					<span class="um__dot" data-state="unknown" />
					<span class="um__name" data-overall>
						Checking…
					</span>
					<span class="um__pct" data-pct>
						—
					</span>
				</div>

				<div
					class="um__bar"
					role="img"
					aria-label="90-day uptime across every monitored service"
				>
					{cells.map((i) => (
						<span
							class="um__cell"
							data-state="empty"
							style={`--i:${i}`}
							aria-hidden="true"
						/>
					))}
				</div>

				<div class="um__foot">
					<span>90 days ago</span>
					<span class="um__latency" data-latency />
					<span>Today</span>
				</div>
			</a>
		</section>
	)
}

{
	variant !== 'unified' && rows.length > 0 && (
		<section class="uptime" data-variant={variant} data-endpoint={project ?? ''}>
			{heading && (
				<header class="uptime__head">
					<h2 class="section-label">
						{variant === 'compact' ? (
							<a class="uptime__more" href="/uptime">
								{heading}
							</a>
						) : (
							heading
						)}
					</h2>
					<p class="uptime__overall" data-overall>
						Checking…
					</p>
				</header>
			)}

			<ul class="uptime__list">
				{rows.map((row) => (
					<li class="um" data-monitor={row.slug}>
						<div class="um__head">
							<span class="um__dot" data-state="unknown" />
							{project ? (
								<span class="um__name">{row.label}</span>
							) : (
								<a class="um__name um__name--link" href={`/work/${row.project}`}>
									{row.label}
								</a>
							)}
							<span class="um__pct" data-pct>
								—
							</span>
						</div>

						<div
							class="um__bar"
							role="img"
							tabindex="0"
							aria-label={`90-day uptime for ${row.label}. Use the arrow keys to read a single day.`}
						>
							{cells.map((i) => (
								<span
									class="um__cell"
									data-state="empty"
									style={`--i:${i}`}
									aria-hidden="true"
								/>
							))}
						</div>

						<p class="um__live" aria-live="polite" data-live />

						<div class="um__foot">
							<span>90 days ago</span>
							<span class="um__latency" data-latency />
							<span>Today</span>
						</div>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.uptime {
		--cell-h: 1.75rem;
		--pad: 0.325rem;
		--ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
		margin-top: 4.5rem;
		scroll-margin-top: 2rem;
	}

	.uptime[data-variant='full'] {
		--cell-h: 2.5rem;
		margin-top: 2.5rem;
	}

	.uptime[data-variant='unified'] {
		--cell-h: 1.375rem;
		margin-top: 2.75rem;
	}

	.uptime__all {
		display: block;
		text-decoration: none;
		color: inherit;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.uptime__all:hover {
		opacity: 0.82;
	}

	.uptime__all:has(.um__bar[data-scrub]) {
		opacity: 1;
	}

	.uptime[data-variant='unified'] .um__name {
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--fg-muted);
		transition: color var(--dur) var(--ease-out);
	}

	.uptime[data-variant='unified'] .um__name[data-state='up'] {
		color: var(--status-up);
	}

	.uptime[data-variant='unified'] .um__name[data-state='degraded'] {
		color: var(--status-degraded);
	}

	.uptime[data-variant='unified'] .um__name[data-state='down'] {
		color: var(--status-down);
	}

	.uptime__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.25rem;
	}

	.uptime__more {
		color: inherit;
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.uptime__more:hover {
		color: var(--fg);
	}

	.uptime__overall {
		font-size: 0.8125rem;
		color: var(--fg-muted);
		transition: color var(--dur) var(--ease-out);
	}

	.uptime__overall[data-state='up'] {
		color: var(--status-up);
	}

	.uptime__overall[data-state='degraded'] {
		color: var(--status-degraded);
	}

	.uptime__overall[data-state='down'] {
		color: var(--status-down);
	}

	.uptime__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.75rem;
	}

	.uptime[data-variant='full'] .uptime__list {
		gap: 2.5rem;
	}

	.um__head {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.um__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		flex-shrink: 0;
		background: var(--status-idle);
		transition: background var(--dur) var(--ease-out);
	}

	.um__dot[data-state='up'] {
		background: var(--status-up);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--status-up) 60%, transparent);
		animation: uptime-pulse 2.8s var(--ease-out) infinite;
	}

	.um__dot[data-state='degraded'] {
		background: var(--status-degraded);
	}

	.um__dot[data-state='down'] {
		background: var(--status-down);
	}

	@keyframes uptime-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--status-up) 55%, transparent);
		}
		70% {
			box-shadow: 0 0 0 0.35rem transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	.um__name {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--fg);
	}

	.um__name--link {
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.um__name--link:hover {
		color: var(--fg-muted);
	}

	.um__pct {
		margin-left: auto;
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		color: var(--fg-muted);
	}

	.um__bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: 2px;
		margin-top: calc(0.6rem - var(--pad));
		height: calc(var(--cell-h) + var(--pad) * 2);
		touch-action: pan-y;
		-webkit-tap-highlight-color: transparent;
	}

	.um__bar:focus-visible {
		outline: 2px solid var(--fg-muted);
		outline-offset: 4px;
		border-radius: 4px;
	}

	.um__bar::before {
		content: '';
		position: absolute;
		inset: -0.5rem 0 -0.35rem;
	}

	.um__cell {
		flex: 1 1 0;
		min-width: 0;
		height: var(--cell-h);
		border-radius: 2px;
		background: var(--border);
		--glow: var(--fg-dim);
		transform: scaleY(0.35);
		transform-origin: center;
		opacity: 0;
		transition:
			transform var(--dur-slow) var(--ease-out) calc(var(--i) * 6ms),
			opacity var(--dur) var(--ease-out) calc(var(--i) * 6ms),
			background var(--dur) var(--ease-out) calc(var(--i) * 6ms);
	}

	.um__cell[data-state='empty'] {
		background: var(--border);
		--glow: var(--fg-dim);
	}

	.um__cell[data-state='up'] {
		background: var(--status-up);
		--glow: var(--status-up);
	}

	.um__cell[data-state='degraded'] {
		background: var(--status-degraded);
		--glow: var(--status-degraded);
	}

	.um__cell[data-state='down'] {
		background: var(--status-down);
		--glow: var(--status-down);
	}

	.um__bar.is-loaded .um__cell {
		transform: scaleY(1);
		opacity: 1;
	}

	.um__bar.is-live .um__cell {
		transition:
			transform 240ms var(--ease-spring),
			opacity 180ms var(--ease-out),
			box-shadow 180ms var(--ease-out),
			background var(--dur) var(--ease-out);
	}

	.um__bar.is-live[data-scrub] .um__cell {
		opacity: 0.5;
	}

	.um__bar.is-live .um__cell[data-near='2'] {
		opacity: 0.75;
		transform: scaleY(1.08);
	}

	.um__bar.is-live .um__cell[data-near='1'] {
		opacity: 0.92;
		transform: scaleY(1.19);
	}

	.um__bar.is-live .um__cell[data-near='0'] {
		opacity: 1;
		transform: scaleY(1.34);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--glow) 70%, transparent),
			0 0 12px -2px color-mix(in srgb, var(--glow) 60%, transparent);
	}

	.um__live {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.um__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: calc(0.5rem - var(--pad));
		font-size: 0.6875rem;
		color: var(--fg-dim);
	}

	.um__latency {
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 640px) {
		.um__cell:nth-child(-n + 45) {
			display: none;
		}

		.um__foot > :first-child::before {
			content: '45 ';
		}

		.um__foot > :first-child {
			font-size: 0;
		}

		.um__foot > :first-child::before,
		.um__foot > :first-child::after {
			font-size: 0.6875rem;
		}

		.um__foot > :first-child::after {
			content: 'days ago';
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.um__cell {
			transition-delay: 0ms;
			transition-duration: 1ms;
		}

		.um__bar.is-live .um__cell {
			transition-duration: 1ms;
		}

		.um__bar.is-live .um__cell[data-near='0'],
		.um__bar.is-live .um__cell[data-near='1'],
		.um__bar.is-live .um__cell[data-near='2'] {
			transform: scaleY(1);
		}

		.um__dot[data-state='up'] {
			animation: none;
		}
	}
</style>

<style is:global>
	.uptip {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 60;
		display: grid;
		gap: 0.15rem;
		width: max-content;
		max-width: 15rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.6rem;
		background: var(--bg-elevated);
		box-shadow: var(--shadow-lift);
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, -100%) scale(0.94);
		transform-origin: 50% 100%;
		transition:
			translate 140ms var(--ease-out),
			opacity 140ms var(--ease-out),
			transform 200ms cubic-bezier(0.34, 1.4, 0.64, 1),
			visibility 140ms;
	}

	.uptip[data-below] {
		transform: translate(-50%, 0) scale(0.94);
		transform-origin: 50% 0;
	}

	.uptip[data-open] {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, -100%) scale(1);
	}

	.uptip[data-open][data-below] {
		transform: translate(-50%, 0) scale(1);
	}

	.uptip[data-jump] {
		transition-property: opacity, transform, visibility;
	}

	.uptip::after {
		content: '';
		position: absolute;
		left: calc(50% + var(--arrow-x, 0px));
		bottom: -0.3rem;
		width: 0.5rem;
		height: 0.5rem;
		margin-left: -0.25rem;
		background: var(--bg-elevated);
		border-right: 1px solid var(--border-strong);
		border-bottom: 1px solid var(--border-strong);
		border-bottom-right-radius: 2px;
		transform: rotate(45deg);
	}

	.uptip[data-below]::after {
		bottom: auto;
		top: -0.3rem;
		border-right: none;
		border-bottom: none;
		border-left: 1px solid var(--border-strong);
		border-top: 1px solid var(--border-strong);
		border-radius: 0;
		border-top-left-radius: 2px;
	}

	.uptip__date {
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}

	.uptip__main {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8125rem;
		font-weight: 550;
		line-height: 1.3;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}

	.uptip__dot {
		width: 0.4rem;
		height: 0.4rem;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--status-idle);
	}

	.uptip__dot[data-state='up'] {
		background: var(--status-up);
	}

	.uptip__dot[data-state='degraded'] {
		background: var(--status-degraded);
	}

	.uptip__dot[data-state='down'] {
		background: var(--status-down);
	}

	.uptip__meta {
		font-size: 0.6875rem;
		line-height: 1.3;
		color: var(--fg-muted);
		font-variant-numeric: tabular-nums;
	}

	.uptip__meta:empty {
		display: none;
	}

	.uptime-haptic {
		position: fixed;
		top: 0;
		left: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
		z-index: -1;
	}

	@media (prefers-reduced-motion: reduce) {
		.uptip {
			transition-duration: 1ms;
		}
	}
</style>

<script>
	type Day = {
		date: string
		uptime: number | null
		avgLatencyMs: number | null
		checks: number
	}

	type Monitor = {
		slug: string
		project: string
		title: string
		status: 'up' | 'degraded' | 'down' | 'unknown'
		uptime24h: number | null
		uptime90d: number | null
		avgLatencyMs: number | null
		lastCheckedAt: string | null
		days: Day[]
	}

	const NEAR = 2
	const INTRO_MS = 620 + 90 * 6
	const LINGER_MS = 1600

	function clamp(value: number, min: number, max: number): number {
		return value < min ? min : value > max ? max : value
	}

	function cellState(day: Day): string {
		if (day.uptime === null || day.checks === 0) return 'empty'
		if (day.uptime >= 99.5) return 'up'
		if (day.uptime >= 95) return 'degraded'
		return 'down'
	}

	function formatPct(value: number | null): string {
		if (value === null) return '—'
		const floored = Math.floor(value * 100) / 100
		return `${floored % 1 === 0 ? floored.toFixed(0) : floored.toFixed(2)}%`
	}

	function describeDay(cell: HTMLElement, day: Day) {
		const date = new Date(`${day.date}T00:00:00Z`).toLocaleDateString('en-US', {
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
		const blank = day.uptime === null || day.checks === 0

		cell.dataset.state = cellState(day)
		cell.dataset.day = date
		cell.dataset.headline = blank ? 'No data' : `${formatPct(day.uptime)} uptime`
		cell.dataset.meta = blank
			? ''
			: [
					day.avgLatencyMs === null ? null : `${day.avgLatencyMs}ms avg`,
					`${day.checks.toLocaleString('en-US')} checks`,
				]
					.filter(Boolean)
					.join(' · ')
	}

	let hapticLabel: HTMLLabelElement | null = null

	function iosHapticLabel(): HTMLLabelElement | null {
		if (hapticLabel?.isConnected) return hapticLabel
		if (!('switch' in HTMLInputElement.prototype)) return null

		const input = document.createElement('input')
		input.type = 'checkbox'
		input.setAttribute('switch', '')
		input.id = 'uptime-haptic-switch'
		input.tabIndex = -1
		input.setAttribute('aria-hidden', 'true')

		const label = document.createElement('label')
		label.htmlFor = input.id
		label.setAttribute('aria-hidden', 'true')

		const wrap = document.createElement('div')
		wrap.className = 'uptime-haptic'
		wrap.setAttribute('aria-hidden', 'true')
		wrap.append(input, label)
		document.body.appendChild(wrap)

		hapticLabel = label
		return label
	}

	function haptic(strong: boolean) {
		if (typeof navigator.vibrate === 'function') {
			navigator.vibrate(strong ? 18 : 6)
			return
		}
		iosHapticLabel()?.click()
	}

	type Tip = {
		root: HTMLElement
		date: HTMLElement
		dot: HTMLElement
		headline: HTMLElement
		meta: HTMLElement
	}

	let tip: Tip | null = null
	let tipOpen = false

	function tooltip(): Tip {
		if (tip?.root.isConnected) return tip

		const root = document.createElement('div')
		root.className = 'uptip'
		root.setAttribute('aria-hidden', 'true')

		const date = document.createElement('span')
		date.className = 'uptip__date'

		const main = document.createElement('span')
		main.className = 'uptip__main'
		const dot = document.createElement('i')
		dot.className = 'uptip__dot'
		const headline = document.createElement('span')
		main.append(dot, headline)

		const meta = document.createElement('span')
		meta.className = 'uptip__meta'

		root.append(date, main, meta)
		document.body.appendChild(root)

		tip = { root, date, dot, headline, meta }
		return tip
	}

	function showTip(cell: HTMLElement, cx: number, top: number, bottom: number, touch: boolean) {
		const t = tooltip()
		t.date.textContent = cell.dataset.day ?? ''
		t.dot.dataset.state = cell.dataset.state ?? 'empty'
		t.headline.textContent = cell.dataset.headline ?? ''
		t.meta.textContent = cell.dataset.meta ?? ''

		if (!tipOpen) {
			t.root.setAttribute('data-jump', '')
			tipOpen = true
		}

		const width = t.root.offsetWidth
		const height = t.root.offsetHeight
		const gap = touch ? 16 : 11
		const edge = 10

		const half = width / 2
		const x =
			window.innerWidth - edge - half < edge + half
				? window.innerWidth / 2
				: clamp(cx, edge + half, window.innerWidth - edge - half)

		const below = top - gap - height < edge
		t.root.toggleAttribute('data-below', below)
		t.root.style.setProperty('--arrow-x', `${clamp(cx - x, -half + 8, half - 8)}px`)
		t.root.style.setProperty('translate', `${x}px ${below ? bottom + gap : top - gap}px`)
		t.root.setAttribute('data-open', '')

		requestAnimationFrame(() => t.root.removeAttribute('data-jump'))
	}

	function hideTip() {
		tip?.root.removeAttribute('data-open')
		tipOpen = false
	}

	type Scrubber = { end: (delay?: number) => void }

	const scrubbers = new Set<Scrubber>()

	function wireBar(bar: HTMLElement, live: HTMLElement | null) {
		let cells: HTMLElement[] = []
		let left = 0
		let span = 1
		let top = 0
		let bottom = 0
		let active = -1
		let scrubbing = false
		let swallowClick = false
		let hideTimer = 0
		let clickTimer = 0

		function measure(): boolean {
			cells = Array.from(bar.querySelectorAll<HTMLElement>('.um__cell')).filter(
				(cell) => cell.offsetParent !== null
			)
			if (!cells.length) return false
			const a = cells[0].getBoundingClientRect()
			const b = cells[cells.length - 1].getBoundingClientRect()
			left = a.left
			span = Math.max(1, b.right - a.left)
			top = a.top
			bottom = a.bottom
			return true
		}

		function indexAt(x: number): number {
			return clamp(Math.floor(((x - left) / span) * cells.length), 0, cells.length - 1)
		}

		function unpaint() {
			for (const cell of bar.querySelectorAll('[data-near]'))
				cell.removeAttribute('data-near')
		}

		function setActive(index: number, touch: boolean) {
			if (index === active) return
			unpaint()
			active = index
			for (let d = -NEAR; d <= NEAR; d++) {
				const cell = cells[index + d]
				if (cell) cell.dataset.near = String(Math.abs(d))
			}

			const cell = cells[index]
			const cx = left + (span * (index + 0.5)) / cells.length
			showTip(cell, cx, top, bottom, touch)
			if (touch) haptic(cell.dataset.state !== 'up')
		}

		function announce() {
			if (!live || active === -1) return
			const cell = cells[active]
			const meta = cell.dataset.meta
			live.textContent = `${cell.dataset.day} — ${cell.dataset.headline}${meta ? `, ${meta}` : ''}`
		}

		function end(delay = 0) {
			window.clearTimeout(hideTimer)
			const run = () => {
				unpaint()
				active = -1
				bar.removeAttribute('data-scrub')
				hideTip()
			}
			if (delay) hideTimer = window.setTimeout(run, delay)
			else run()
		}

		function begin(x: number, touch: boolean): boolean {
			window.clearTimeout(hideTimer)
			if (!measure()) return false
			active = -1
			bar.setAttribute('data-scrub', '')
			setActive(indexAt(x), touch)
			return true
		}

		bar.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse') return
			begin(event.clientX, false)
		})

		bar.addEventListener('pointermove', (event) => {
			if (event.pointerType === 'mouse') {
				if (active === -1) begin(event.clientX, false)
				else setActive(indexAt(event.clientX), false)
			} else if (scrubbing) {
				setActive(indexAt(event.clientX), true)
			}
		})

		bar.addEventListener('pointerleave', (event) => {
			if (event.pointerType === 'mouse') end()
		})

		bar.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'mouse') return
			if (!begin(event.clientX, true)) return
			scrubbing = true
			swallowClick = true
			window.clearTimeout(clickTimer)
			bar.setPointerCapture(event.pointerId)
		})

		const release = () => {
			if (!scrubbing) return
			scrubbing = false
			end(LINGER_MS)
			clickTimer = window.setTimeout(() => {
				swallowClick = false
			}, 500)
		}

		bar.addEventListener('pointerup', release)
		bar.addEventListener('pointercancel', release)

		bar.addEventListener(
			'click',
			(event) => {
				if (!swallowClick) return
				swallowClick = false
				event.preventDefault()
				event.stopPropagation()
			},
			true
		)

		bar.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				end()
				return
			}
			const step =
				event.key === 'ArrowRight'
					? 1
					: event.key === 'ArrowLeft'
						? -1
						: event.key === 'Home'
							? -Infinity
							: event.key === 'End'
								? Infinity
								: 0
			if (!step) return
			event.preventDefault()
			if (active === -1) {
				if (!begin(bar.getBoundingClientRect().right, false)) return
			} else {
				setActive(clamp(active + step, 0, cells.length - 1), false)
			}
			announce()
		})

		bar.addEventListener('blur', () => end())

		const scrubber: Scrubber = { end }
		scrubbers.add(scrubber)
		return scrubber
	}

	function endAll() {
		for (const scrubber of scrubbers) scrubber.end()
	}

	function combine(monitors: Monitor[]): Monitor | null {
		if (!monitors.length) return null

		const dayCount = Math.max(...monitors.map((m) => m.days.length))
		const days: Day[] = Array.from({ length: dayCount }, (_, i) => {
			let checks = 0
			let ok = 0
			let latencySum = 0
			let latencyCount = 0
			let date = ''

			for (const monitor of monitors) {
				const day = monitor.days[i]
				if (!day) continue
				date ||= day.date
				if (day.uptime === null || day.checks === 0) continue
				checks += day.checks
				ok += (day.uptime / 100) * day.checks
				if (day.avgLatencyMs !== null) {
					latencySum += day.avgLatencyMs * day.checks
					latencyCount += day.checks
				}
			}

			return {
				date,
				uptime: checks ? (ok / checks) * 100 : null,
				avgLatencyMs: latencyCount ? Math.round(latencySum / latencyCount) : null,
				checks,
			}
		})

		const totals = days.reduce(
			(acc, d) => {
				if (d.uptime !== null) {
					acc.ok += (d.uptime / 100) * d.checks
					acc.total += d.checks
				}
				return acc
			},
			{ ok: 0, total: 0 }
		)

		const known = monitors.filter((m) => m.status !== 'unknown')
		const status: Monitor['status'] = !known.length
			? 'unknown'
			: known.some((m) => m.status === 'down')
				? 'down'
				: known.some((m) => m.status === 'degraded')
					? 'degraded'
					: 'up'

		const latencies = monitors.map((m) => m.avgLatencyMs).filter((v): v is number => v !== null)

		return {
			slug: 'all',
			project: 'all',
			title: 'All systems',
			status,
			uptime24h: null,
			uptime90d: totals.total ? (totals.ok / totals.total) * 100 : null,
			avgLatencyMs: latencies.length
				? Math.round(latencies.reduce((a, b) => a + b, 0) / latencies.length)
				: null,
			lastCheckedAt: null,
			days,
		}
	}

	function fillBar(bar: HTMLElement | null, days: Day[]) {
		if (!bar) return
		const cells = bar.querySelectorAll<HTMLElement>('.um__cell')
		days.forEach((day, i) => {
			const cell = cells[i]
			if (cell) describeDay(cell, day)
		})
		bar.classList.add('is-loaded')
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
		window.setTimeout(() => bar.classList.add('is-live'), still ? 0 : INTRO_MS)
	}

	function renderUnified(section: HTMLElement, monitors: Monitor[]) {
		const all = combine(monitors)
		const label = section.querySelector('[data-overall]')

		if (!all || all.status === 'unknown') {
			if (label) {
				label.textContent = 'No data yet'
				label.removeAttribute('data-state')
			}
			return
		}

		section.querySelector('.um__dot')?.setAttribute('data-state', all.status)

		if (label) {
			label.textContent =
				all.status === 'up'
					? 'All systems operational'
					: all.status === 'degraded'
						? 'Degraded performance'
						: 'Partial outage'
			label.setAttribute('data-state', all.status)
		}

		const pct = section.querySelector('[data-pct]')
		if (pct) pct.textContent = `${formatPct(all.uptime90d)} uptime`

		const latency = section.querySelector('[data-latency]')
		if (latency) {
			latency.textContent = all.avgLatencyMs === null ? '' : `${all.avgLatencyMs}ms avg · 24h`
		}

		fillBar(section.querySelector<HTMLElement>('.um__bar'), all.days)
	}

	function render(section: HTMLElement, monitors: Monitor[]) {
		let worst: Monitor['status'] = 'up'
		let known = 0

		for (const monitor of monitors) {
			const row = section.querySelector<HTMLElement>(`.um[data-monitor="${monitor.slug}"]`)
			if (!row) continue

			if (monitor.status !== 'unknown') {
				known++
				if (monitor.status === 'down') worst = 'down'
				else if (monitor.status === 'degraded' && worst !== 'down') worst = 'degraded'
			}

			row.querySelector('.um__dot')?.setAttribute('data-state', monitor.status)

			const pct = row.querySelector('[data-pct]')
			if (pct) pct.textContent = `${formatPct(monitor.uptime90d)} uptime`

			const latency = row.querySelector('[data-latency]')
			if (latency) {
				latency.textContent =
					monitor.avgLatencyMs === null ? '' : `${monitor.avgLatencyMs}ms avg · 24h`
			}

			fillBar(row.querySelector<HTMLElement>('.um__bar'), monitor.days)
		}

		const overall = section.querySelector('[data-overall]')
		if (overall) {
			if (!known) {
				overall.textContent = 'No data yet'
				overall.removeAttribute('data-state')
			} else {
				overall.textContent =
					worst === 'up'
						? 'All systems operational'
						: worst === 'degraded'
							? 'Degraded performance'
							: 'Partial outage'
				overall.setAttribute('data-state', worst)
			}
		}
	}

	let globalsBound = false

	function initUptime() {
		scrubbers.clear()
		hideTip()

		const sections = document.querySelectorAll<HTMLElement>('.uptime')
		if (!sections.length) return

		for (const section of sections) {
			const project = section.dataset.endpoint
			const url = project
				? `/api/uptime?project=${encodeURIComponent(project)}`
				: '/api/uptime'
			const unified = section.dataset.variant === 'unified'

			fetch(url)
				.then((res) => res.json())
				.then((data: { monitors?: Monitor[] }) => {
					if (!Array.isArray(data?.monitors)) return
					if (unified) renderUnified(section, data.monitors)
					else render(section, data.monitors)
				})
				.catch(() => {
					const overall = section.querySelector('[data-overall]')
					if (overall) overall.textContent = 'Status unavailable'
				})

			for (const bar of section.querySelectorAll<HTMLElement>('.um__bar')) {
				const row = bar.closest('.um') ?? section
				wireBar(bar, row.querySelector<HTMLElement>('[data-live]'))
			}
		}

		if (globalsBound) return
		globalsBound = true
		document.addEventListener('scroll', endAll, { passive: true, capture: true })
		window.addEventListener('resize', endAll, { passive: true })
	}

	document.addEventListener('astro:page-load', initUptime)
</script>
