---
import ProjectCard from './ProjectCard.astro'
import Icon from './Icon.astro'
import { featuredProjects } from '../data/projects'
---

<section class="work" id="work" aria-labelledby="work-heading">
	<header class="section-head" data-enter style="--d:3">
		<h2 class="section-title" id="work-heading">Selected work</h2>
		<p class="section-lede">Products I've built and still run in production.</p>
	</header>

	<ul class="work__list">
		{
			featuredProjects.map((project, i) => (
				<li class="work__item" data-enter style={`--d:${4 + Math.min(i, 3)}`}>
					<ProjectCard project={project} />
				</li>
			))
		}
		{
			featuredProjects.length % 2 === 1 && (
				<li class="work__item work__item--contact" data-reveal>
					<a href="#" data-contact-link class="card card--contact">
						<div class="cover cover--contact">
							<Icon name="mail-02" size={26} class="contact__icon" />
							<h3 class="contact__title">Have a project in mind?</h3>
							<p class="contact__tagline">
								I'm always up for building something with someone. Tell me about
								it.
							</p>
							<span class="contact__cta">
								Get in touch
								<Icon name="arrow-right-01" size={14} />
							</span>
						</div>
					</a>
				</li>
			)
		}
	</ul>
</section>

<style>
	.work {
		margin-top: 5rem;
		scroll-margin-top: 2rem;
	}

	.work__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 3rem 2rem;
	}

	@media (min-width: 640px) {
		.work__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.card--contact {
		display: block;
	}

	.cover--contact {
		position: relative;
		aspect-ratio: 16 / 10;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		text-align: center;
		padding: 1.5rem;
		border-radius: 0.75rem;
		border: 1px dashed var(--border-strong);
		background: var(--bg-elevated);
		transition: border-color var(--dur) var(--ease-out);
	}

	.card--contact:hover .cover--contact,
	.card--contact:focus-visible .cover--contact {
		border-color: var(--fg-dim);
	}

	.contact__icon {
		color: var(--fg-dim);
	}

	.contact__title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--fg);
	}

	.contact__tagline {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--fg-muted);
		max-width: 20rem;
	}

	.contact__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.4rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--fg);
	}

	.contact__cta :global(svg) {
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.card--contact:hover .contact__cta :global(svg) {
		transform: translateX(3px);
	}
</style>
