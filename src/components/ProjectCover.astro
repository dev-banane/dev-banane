---
import type { Project } from '../data/projects'

interface Props {
	project: Project
	sizes?: string
	eager?: boolean
	class?: string
}

const { project, sizes, eager = false, class: className } = Astro.props

const hasCover = Boolean(project.cover)
---

<div class:list={['cover', className]}>
	<div class="cover__fallback" aria-hidden="true">
		<span class="cover__fallback-title">{project.title}</span>
		{
			import.meta.env.DEV && (
				<span class="cover__fallback-hint">public/assets/work/{project.slug}.webp</span>
			)
		}
	</div>

	{
		hasCover && (
			<div class="cover__frame">
				<img
					src={project.cover}
					alt={project.coverAlt ?? `${project.title} screenshot`}
					class="cover__img"
					width="1600"
					height="1000"
					sizes={sizes}
					loading={eager ? 'eager' : 'lazy'}
					decoding="async"
					onerror="this.parentElement.remove()"
				/>
			</div>
		)
	}
</div>

<style>
	.cover {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.75rem;
		border: 1px solid var(--border);
		background: var(--cover-bg);
		transition: border-color var(--dur) var(--ease-out);
	}

	:global(a:hover) > .cover,
	:global(a:focus-visible) > .cover {
		border-color: var(--border-strong);
	}

	.cover__frame {
		position: absolute;
		z-index: 1;
		top: 8%;
		left: 7%;
		right: 7%;
		bottom: -1px;
		overflow: hidden;
		border-radius: 0.5rem 0.5rem 0 0;
		border: 1px solid var(--border-strong);
		border-bottom: none;
		background: var(--bg);
		box-shadow: var(--shadow-frame);
		transform-origin: 50% 100%;
		transition: transform var(--dur-slow) var(--ease-out);
	}

	:global(a:hover) > .cover .cover__frame,
	:global(a:focus-visible) > .cover .cover__frame {
		transform: scale(1.04);
	}

	.cover__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	.cover__fallback {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		text-align: center;
		padding: 1.5rem;
		background: repeating-linear-gradient(135deg, transparent 0 10px, var(--border) 10px 11px);
	}

	.cover:has(.cover__frame) .cover__fallback {
		display: none;
	}

	.cover__fallback-title {
		font-size: clamp(1.25rem, 4vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--fg-dim);
	}

	.cover__fallback-hint {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6875rem;
		color: var(--fg-dim);
		opacity: 0.7;
	}
</style>
