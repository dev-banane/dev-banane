---
import Icon from './Icon.astro'
---

<button id="theme-toggle" class="theme-toggle" role="switch" aria-label="Toggle dark mode">
	<Icon name="sun-03" class="theme-toggle__icon theme-toggle__icon--sun" size={16} />
	<Icon name="moon-02" class="theme-toggle__icon theme-toggle__icon--moon" size={16} />
</button>

<style is:global>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
		padding: 0;
		border: none;
		border-radius: 9999px;
		background: none;
		color: var(--fg-dim);
		cursor: pointer;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.theme-toggle:hover {
		background: var(--btn-social-bg);
		color: var(--fg);
	}

	.theme-toggle__icon {
		grid-area: 1 / 1;
		opacity: 0;
		transform: scale(0.6) rotate(-40deg);
		transition:
			opacity var(--dur) var(--ease-out),
			transform var(--dur) var(--ease-out);
	}

	[data-theme='light'] .theme-toggle__icon--sun,
	[data-theme='dark'] .theme-toggle__icon--moon {
		opacity: 1;
		transform: scale(1) rotate(0deg);
	}
</style>
