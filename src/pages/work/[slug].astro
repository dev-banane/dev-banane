---
export const prerender = false

import Icon from '../../components/Icon.astro'
import Layout from '../../layouts/Layout.astro'
import TopBar from '../../components/TopBar.astro'
import ProjectCover from '../../components/ProjectCover.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import StatusBadge from '../../components/StatusBadge.astro'
import Uptime from '../../components/Uptime.astro'
import Footer from '../../components/Footer.astro'
import TechStack from '../../components/TechStack.astro'
import { projects } from '../../data/projects'
import { getPFControlStats, formatFloor } from '../../lib/pfcontrol-stats'

const project = projects.find((p) => p.slug === Astro.params.slug)
if (!project) {
	return new Response('Project not found', { status: 404 })
}

let highlights = project.highlights
if (project.slug === 'pfcontrol') {
	const stats = await getPFControlStats()
	highlights = [
		{ label: 'Registered users', value: formatFloor(stats.registeredUsers) },
		{ label: 'Flights logged, last 30 days', value: formatFloor(stats.flightsLogged30d) },
		{ label: 'Sessions, last 30 days', value: formatFloor(stats.sessionsCreated30d, 100) },
		{ label: 'Daily active users', value: '~500' },
	]
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600')

const canonical = `https://devjakob.com/work/${project.slug}`
const description = `${project.title}. ${project.tagline} Built by Jakob Pütz.`
const ogImage = project.cover
	? `https://devjakob.com${project.cover}`
	: 'https://devjakob.com/assets/avatar.jpg'

const projectSchema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description,
	url: canonical,
	image: ogImage,
	author: { '@type': 'Person', name: 'Jakob Pütz', url: 'https://devjakob.com' },
	keywords: project.stack.join(', '),
	inLanguage: 'en',
	...(project.links?.length ? { sameAs: project.links.map((l) => l.href) } : {}),
}

const others = projects.filter((p) => p.slug !== project.slug).slice(0, 2)
const hasLinks = Boolean(project.article || project.links?.length)
const [primaryLink, ...secondaryLinks] = project.links ?? []
const primaryLabel =
	primaryLink?.label === 'GitHub'
		? 'View on GitHub'
		: primaryLink?.label === 'Chrome Web Store'
			? 'Add to Chrome'
			: `Visit ${primaryLink?.label}`
---

<Layout
	title={`${project.title} · Jakob Pütz`}
	description={description}
	canonical={canonical}
	ogImage={ogImage}
	schema={projectSchema}
>
	<TopBar href="/#work" label="All work" width="52rem" />

	<div class="page">
		<div class="inner">
			<header class="head">
				<div class="title-row" data-enter style="--d:0">
					<h1 class="title">{project.title}</h1>
					<StatusBadge status={project.status} />
				</div>
				<p class="subline" data-enter style="--d:1">
					{project.role}
					{project.period && ` · ${project.period}`}
				</p>
				<p class="tagline" data-enter style="--d:2">{project.tagline}</p>

				{
					hasLinks && (
						<nav class="links" aria-label="Project links" data-enter style="--d:3">
							{primaryLink && (
								<a
									href={primaryLink.href}
									class="btn btn--primary"
									target="_blank"
									rel="noopener noreferrer"
								>
									{primaryLink.label === 'GitHub' ? (
										<Icon name="github-01" size={16} />
									) : null}
									{primaryLabel}
									{primaryLink.label !== 'GitHub' && <Icon name="link-square-02" size={16} />}
								</a>
							)}
							{project.article && (
								<a href={`/posts/${project.article}`} class="btn" data-astro-prefetch>
									<Icon name="file-01" size={16} />
									Read the write-up
								</a>
							)}
							{secondaryLinks.map((link) => (
								<a
									href={link.href}
									class="btn"
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon name={link.label === 'GitHub' ? 'github-01' : 'link-02'} size={16} />
									{link.label}
								</a>
							))}
						</nav>
					)
				}
			</header>

			<div class="cover-wrap" data-enter style="--d:4">
				<ProjectCover project={project} eager sizes="(min-width: 52rem) 52rem, 100vw" />
			</div>

			<div class="body" data-reveal>
				{project.summary.map((paragraph) => <p>{paragraph}</p>)}

				{
					highlights && (
						<dl class="stats">
							{highlights.map((stat) => (
								<div class="stat">
									<dt>{stat.label}</dt>
									<dd>{stat.value}</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>

			<div class="stack-used" data-reveal>
				<h2 class="section-title">Stack</h2>
				<TechStack stack={project.stack} size="lg" class="stack-icons" />
			</div>

			{
				Boolean(project.monitors?.length) && (
					<div data-reveal>
						<Uptime project={project.slug} heading="Uptime" variant="full" />
					</div>
				)
			}

			{
				others.length > 0 && (
					<nav class="more" aria-label="Other projects" data-reveal>
						<h2 class="section-title more__title">More work</h2>
						<ul class="more__list">
							{others.map((other) => (
								<li class="more__item">
									<ProjectCard project={other} />
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>

	<Footer width="52rem" />
</Layout>

<style>
	.page {
		min-height: 100vh;
		padding: 2.5rem 1.5rem 5rem;
	}

	.inner {
		width: 100%;
		max-width: 52rem;
		margin: 0 auto;
	}

	.title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
	}

	.title {
		font-size: clamp(1.875rem, 5vw, 2.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: var(--fg);
	}

	.subline {
		margin-top: 0.6rem;
		font-size: 0.875rem;
		color: var(--fg-dim);
	}

	.tagline {
		margin-top: 0.5rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--fg-muted);
		max-width: 36rem;
	}

	.cover-wrap {
		margin-top: 2.5rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}

	.body {
		margin-top: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.body p {
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--fg-muted);
	}

	.stats {
		margin: 1.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		row-gap: 1.5rem;
	}

	/* dt stays first for screen readers; the number is shown on top. */
	.stat {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 0.45rem;
		padding: 0.1rem 1.25rem;
		border-left: 1px solid var(--border);
	}

	.stat:first-child {
		padding-left: 0;
		border-left: none;
	}

	.stat dd {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		background: linear-gradient(180deg, var(--fg) 40%, var(--fg-muted));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.stat dt {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--fg-muted);
		text-wrap: balance;
	}

	@media (max-width: 560px) {
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.stat:nth-child(odd) {
			padding-left: 0;
			border-left: none;
		}
	}

	.stack-used {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.stack-used :global(.stack-icons) {
		margin-top: 1rem;
	}

	.more {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.more__title {
		margin-bottom: 1.5rem;
	}

	.more__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2.5rem 1.75rem;
	}

	@media (min-width: 640px) {
		.more__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
