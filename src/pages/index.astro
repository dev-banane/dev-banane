---
export const prerender = false

import Icon from '../components/Icon.astro'
import Layout from '../layouts/Layout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import WorkShowcase from '../components/WorkShowcase.astro'
import Uptime from '../components/Uptime.astro'
import { socials } from '../data/site'
import { featuredProjects } from '../data/projects'
import { fetchPostList } from '../lib/posts'
import { env } from 'cloudflare:workers'

const posts = await fetchPostList(env.MEDIA)
const HOMEPAGE_POSTS = 5
const visiblePosts = posts.slice(0, HOMEPAGE_POSTS)
const remainingPosts = posts.length - visiblePosts.length

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

const workSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: "Jakob Pütz's projects",
	itemListElement: featuredProjects.map((p, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: `https://devjakob.com/work/${p.slug}`,
		name: p.title,
	})),
}

function formatDate(iso: string) {
	return new Date(iso).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})
}
---

<Layout
	title="Jakob Pütz"
	description="Jakob Pütz (Jakob Puetz, devjakob), 17-year-old full-stack developer from Aachen, Germany. Building Weavay, Petal and PFControl. TypeScript, Next.js, Postgres."
	schema={workSchema}
>
	<div class="page">
		<div class="inner">
			<article class="about">
				<div class="name-row" data-enter style="--d:0">
					<div>
						<h1 class="name">Jakob Pütz</h1>
						<p class="role">Full-stack developer · Aachen, Germany</p>
					</div>
					<div class="name-row__right">
						<ThemeToggle />
						<img
							src="/assets/avatar.jpg"
							alt="Jakob Pütz"
							class="profile-avatar"
							width="52"
							height="52"
						/>
					</div>
				</div>

				<div class="prose" data-enter style="--d:1">
					<p>
						Hey, I'm a 17-year-old developer. I've been building software since my early
						teens, and what started as curiosity quickly turned into a serious passion
						for making things people actually use.
					</p>
					<p>
						Right now I'm building <a
							href="/work/weavay"
							class="link"
							data-astro-prefetch>Weavay</a
						>, an email client that treats your mail as a living graph of the people and
						threads it touches instead of a folder tree, and <a
							href="/work/pfcontrol"
							class="link"
							data-astro-prefetch>PFControl</a
						>, an ATC strip management platform I've been working on since I was 15 with
						thousands of registered users and ~500 daily actives. <a
							href="/work/petal"
							class="link"
							data-astro-prefetch>Petal</a
						>, a unified AI workspace, is in the mix too.
					</p>
					<p>
						I work across the full stack with TypeScript, Next.js, Postgres, and
						whatever else the problem needs. Outside of code I'm interested in aviation,
						space as well as photography.
						<br />
						<a href="#" class="link" id="contact-link">Feel free to contact me!</a>
					</p>
				</div>

				<div class="socials" data-enter style="--d:2">
					{
						socials.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer me"
								class="btn btn--social"
								aria-label={s.label}
							>
								<Icon name={s.icon} class="btn-icon" size={18} />
								{s.label}
							</a>
						))
					}
				</div>

				<address class="sr-only" aria-hidden="true">
					Jakob Pütz, also known as Jakob Puetz, devjakob, and dev-banane, web developer
					based in Aachen, Germany.
				</address>
			</article>

			<div data-enter style="--d:3">
				<Uptime variant="unified" />
			</div>

			<section class="writing" aria-labelledby="writing-heading">
				<header class="writing-head" data-enter style="--d:4">
					<p class="writing-lede" id="writing-heading">
						Notes on what I build and how it works.
					</p>
				</header>

				{
					posts.length === 0 ? (
						<p class="empty">Nothing published yet.</p>
					) : (
						<Fragment>
							<ul class="post-list">
								{visiblePosts.map((p, i) => (
									<li data-enter style={`--d:${5 + Math.min(i, 3)}`}>
										<a
											href={`/posts/${p.slug}`}
											class="post-link"
											data-astro-prefetch
										>
											<span class="post-title">{p.title}</span>
											<span class="post-date">{formatDate(p.date)}</span>
										</a>
									</li>
								))}
							</ul>

							{remainingPosts > 0 && (
								<a
									href="/posts"
									class="more-link"
									data-enter
									style="--d:8"
									data-astro-prefetch
								>
									Show more
									<Icon name="arrow-right-01" size={15} class="more-link__icon" />
								</a>
							)}
						</Fragment>
					)
				}
			</section>

			<WorkShowcase />
		</div>
	</div>
</Layout>

<style>
	.page {
		padding: 3.5rem 1.5rem 7rem;
	}

	.inner {
		width: 100%;
		max-width: 48rem;
		margin: 0 auto;
	}

	.about {
		width: 100%;
		margin-top: 1.5rem;
	}

	.name-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.name-row__right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.profile-avatar {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		display: block;
		border: 1px solid var(--border);
	}

	.name {
		font-size: clamp(1.75rem, 4vw, 2.125rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: var(--fg);
	}

	.role {
		font-size: 0.9375rem;
		color: var(--fg-muted);
		margin-top: 0.5rem;
	}

	.prose {
		margin-top: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.prose p {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--fg-muted);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.writing {
		margin-top: 4.5rem;
	}

	.writing-head {
		padding-bottom: 0.5rem;
	}

	.writing-lede {
		margin-top: 0.6rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}

	.post-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.85rem 0;
		border-top: 1px solid var(--border);
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.post-list li:last-child .post-link {
		border-bottom: 1px solid var(--border);
	}

	.post-link:hover {
		opacity: 0.75;
	}

	.post-title {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--fg);
		transition: transform var(--dur) var(--ease-out);
	}

	.post-link:hover .post-title {
		transform: translateX(4px);
	}

	.more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.1rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--fg-dim);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.more-link:hover {
		color: var(--fg);
	}

	.more-link__icon {
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.more-link:hover .more-link__icon {
		transform: translateX(3px);
	}

	.post-date {
		font-size: 0.8125rem;
		color: var(--fg-dim);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.empty {
		margin-top: 1rem;
		font-size: 0.9rem;
		color: var(--fg-dim);
	}
</style>

<script>
	function initContactLink() {
		const link = document.getElementById('contact-link') as HTMLAnchorElement | null
		if (!link) return
		link.href = `mailto:${'me'}@${'devjakob.com'}`
	}

	document.addEventListener('astro:page-load', initContactLink)
</script>
