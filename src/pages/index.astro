---
export const prerender = false

import Icon from '../components/Icon.astro'
import Layout from '../layouts/Layout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import WorkShowcase from '../components/WorkShowcase.astro'
import Uptime from '../components/Uptime.astro'
import Footer from '../components/Footer.astro'
import { socials, experience, CHAT_ENABLED } from '../data/site'
import { featuredProjects } from '../data/projects'
import { fetchPostList } from '../lib/posts'
import { getPFControlStats, formatFloor } from '../lib/pfcontrol-stats'
import { env } from 'cloudflare:workers'

const [posts, pfStats] = await Promise.all([fetchPostList(env.MEDIA), getPFControlStats()])
const HOMEPAGE_POSTS = 5
const visiblePosts = posts.slice(0, HOMEPAGE_POSTS)
const remainingPosts = posts.length - visiblePosts.length

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

const workSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: "Jakob Pütz's projects",
	itemListElement: featuredProjects.map((p, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: `https://devjakob.com/work/${p.slug}`,
		name: p.title,
	})),
}

function formatDate(iso: string) {
	return new Date(iso).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})
}
---

<Layout
	title="Jakob Pütz · Full-stack developer"
	description="Jakob Pütz (Jakob Puetz, devjakob), 17-year-old full-stack developer from Aachen, Germany. Creator of PFControl, building Weavay and Petal. TypeScript, React, Next.js, Postgres, Cloudflare."
	schema={workSchema}
>
	<main class="page">
		<div class="inner">
			<section class="about" aria-labelledby="name">
				<div class="name-row" data-enter style="--d:0">
					<div>
						<h1 class="name" id="name">Jakob Pütz</h1>
						<p class="role">
							<span>Full-stack developer</span>
							<span class="role__sep" aria-hidden="true">·</span>
							<span>Aachen, Germany</span>
						</p>
					</div>
					<div class="name-row__right">
						<ThemeToggle />
						<img
							src="/assets/avatar.jpg"
							alt="Jakob Pütz"
							class="profile-avatar"
							width="52"
							height="52"
						/>
					</div>
				</div>

				<div class="prose" data-enter style="--d:1">
					<p>
						I build and ship products people actually use. I started <a
							href="/work/pfcontrol"
							class="link"
							data-astro-prefetch>PFControl</a
						>, a flight-strip platform for virtual air traffic controllers, at 15. Today
						it has {formatFloor(pfStats.registeredUsers)} registered users and around 500 daily actives.
					</p>
					<p>
						Right now I'm building <a href="/work/weavay" class="link" data-astro-prefetch
							>Weavay</a
						>, an email client that threads mail into real conversations, and <a
							href="/work/petal"
							class="link"
							data-astro-prefetch>Petal</a
						>, a memory-first AI workspace. I work across the stack with TypeScript,
						React, Postgres and Cloudflare. I'm 17, self-taught, and into aviation,
						space and photography when I'm not coding.
					</p>
				</div>

				<div class="actions" data-enter style="--d:2">
					<a href="#" class="btn btn--primary" data-contact-link>
						<Icon name="mail-02" class="btn-icon" size={18} />
						Get in touch
					</a>
					{
						CHAT_ENABLED && (
							<a href="/chat" class="btn" data-astro-prefetch>
								<Icon name="ai-chat-02" class="btn-icon" size={18} />
								Ask my AI
							</a>
						)
					}
					{
						socials.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer me"
								class="btn"
								aria-label={s.label}
							>
								<Icon name={s.icon} class="btn-icon" size={18} />
								<span class="btn-label">{s.label}</span>
							</a>
						))
					}
				</div>

				<address class="sr-only" aria-hidden="true">
					Jakob Pütz, also known as Jakob Puetz, devjakob, and dev-banane, web developer
					based in Aachen, Germany.
				</address>
			</section>

			<WorkShowcase />

			<section class="experience" aria-labelledby="experience-heading" data-reveal>
				<header class="section-head">
					<h2 class="section-title" id="experience-heading">Experience</h2>
					<p class="section-lede">Where I build things when it isn't a side project.</p>
				</header>

				<ol class="xp-list">
					{
						experience.map((xp) => (
							<li class="xp">
								<div class="xp__main">
									<p class="xp__title">
										{xp.role}
										<span class="xp__at">at</span>
										{xp.href ? (
											<a
												href={xp.href}
												class="link"
												target="_blank"
												rel="noopener noreferrer"
											>
												{xp.org}
											</a>
										) : (
											xp.org
										)}
									</p>
									<p class="xp__summary">{xp.summary}</p>
								</div>
								<span class="xp__period">{xp.period}</span>
							</li>
						))
					}
				</ol>
			</section>

			<section class="writing" aria-labelledby="writing-heading" data-reveal>
				<header class="section-head">
					<h2 class="section-title" id="writing-heading">Writing</h2>
					<p class="section-lede">Notes on what I build and how it works.</p>
				</header>

				{
					posts.length === 0 ? (
						<p class="empty">Nothing published yet.</p>
					) : (
						<Fragment>
							<ul class="post-list">
								{visiblePosts.map((p) => (
									<li>
										<a
											href={`/posts/${p.slug}`}
											class="post-link"
											data-astro-prefetch
										>
											<span class="post-title">{p.title}</span>
											<span class="post-date">{formatDate(p.date)}</span>
										</a>
									</li>
								))}
							</ul>

							{remainingPosts > 0 && (
								<a href="/posts" class="more-link" data-astro-prefetch>
									All {posts.length} posts
									<Icon name="arrow-right-01" size={15} class="more-link__icon" />
								</a>
							)}
						</Fragment>
					)
				}
			</section>

			<section class="status" aria-labelledby="status-heading" data-reveal>
				<header class="section-head">
					<h2 class="section-title" id="status-heading">Status</h2>
					<p class="section-lede">
						Everything I run is monitored around the clock. 90 days of history.
					</p>
				</header>
				<Uptime variant="unified" />
			</section>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.page {
		padding: 3.5rem 1.5rem 5rem;
	}

	.inner {
		width: 100%;
		max-width: 48rem;
		margin: 0 auto;
	}

	.about {
		width: 100%;
		margin-top: 1.5rem;
	}

	.name-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.name-row__right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.profile-avatar {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		display: block;
		border: 1px solid var(--border);
	}

	.name {
		font-size: clamp(1.75rem, 4vw, 2.125rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: var(--fg);
	}

	.role {
		display: flex;
		flex-wrap: wrap;
		column-gap: 0.4rem;
		font-size: 0.9375rem;
		color: var(--fg-muted);
		margin-top: 0.5rem;
	}

	.role span {
		white-space: nowrap;
	}

	@media (max-width: 420px) {
		.role__sep {
			display: none;
		}

		.role {
			flex-direction: column;
			row-gap: 0.1rem;
		}
	}

	.prose {
		margin-top: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: 42rem;
	}

	.prose p {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--fg-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	@media (max-width: 480px) {
		.actions .btn-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}

		.actions .btn:has(.btn-label) {
			width: 2.5rem;
			padding: 0;
		}
	}

	.experience,
	.writing,
	.status {
		margin-top: 5rem;
	}

	.status :global(.uptime) {
		margin-top: 0;
	}

	.xp-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.xp {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.xp:last-child {
		border-bottom: 1px solid var(--border);
	}

	.xp__title {
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--fg);
	}

	.xp__at {
		color: var(--fg-dim);
		font-weight: 400;
		margin: 0 0.15rem;
	}

	.xp__summary {
		margin-top: 0.25rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.xp__period {
		font-size: 0.8125rem;
		color: var(--fg-dim);
		white-space: nowrap;
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.post-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.85rem 0;
		border-top: 1px solid var(--border);
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.post-list li:last-child .post-link {
		border-bottom: 1px solid var(--border);
	}

	.post-link:hover {
		opacity: 0.75;
	}

	.post-title {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--fg);
		transition: transform var(--dur) var(--ease-out);
	}

	.post-link:hover .post-title {
		transform: translateX(4px);
	}

	.more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.1rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--fg-muted);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.more-link:hover {
		color: var(--fg);
	}

	.more-link__icon {
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.more-link:hover .more-link__icon {
		transform: translateX(3px);
	}

	.post-date {
		font-size: 0.8125rem;
		color: var(--fg-dim);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.empty {
		font-size: 0.9rem;
		color: var(--fg-dim);
	}
</style>
