---
export const prerender = false

import Article from '../../layouts/Article.astro'
import { fetchPost } from '../../lib/posts'
import { fetchComments } from '../../lib/comments'
import { env } from 'cloudflare:workers'

const { slug } = Astro.params
if (!slug) {
	return new Response('Not found', { status: 404 })
}

const [remote, comments] = await Promise.all([
	fetchPost(slug, env.MEDIA),
	fetchComments(env.DB, slug),
])

if (!remote) {
	return new Response('Post not found', { status: 404 })
}

const title = remote.title ?? slug
const date = remote.date ?? ''

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600')
---

<Article title={title} date={date} slug={slug} html={remote.html} comments={comments} />
