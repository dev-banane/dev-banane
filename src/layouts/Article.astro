---
import Layout from './Layout.astro'
import PostStats from '../components/PostStats.astro'
import Comments from '../components/Comments.astro'
import TopBar from '../components/TopBar.astro'
import type { Comment } from '../lib/comments'

interface Props {
	title: string
	date: string
	slug: string
	html?: string
	comments?: Comment[]
}

const { title, date, slug, html, comments = [] } = Astro.props
const formatted = new Date(date).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})

function estimateReadingMinutes(content?: string): number {
	if (!content) return 1
	const text = content
		.replace(/<[^>]+>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim()
	const words = text ? text.split(' ').filter(Boolean).length : 0
	return Math.max(1, Math.round(words / 200))
}

const readingMinutes = estimateReadingMinutes(html)

function extractExcerpt(content?: string): string {
	if (!content) return ''
	const text = content
		.replace(/<[^>]+>/g, ' ')
		.replace(/&nbsp;/g, ' ')
		.replace(/&#(\d+);/g, (_, code: string) => String.fromCodePoint(Number(code)))
		.replace(/&quot;/g, '"')
		.replace(/&#x27;|&apos;/g, "'")
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&amp;/g, '&')
		.replace(/\s+/g, ' ')
		.trim()
	if (text.length <= 155) return text
	return `${text.slice(0, 155).replace(/\s+\S*$/, '')}…`
}

const excerpt = extractExcerpt(html)
const description = excerpt || `${title}, by Jakob Pütz, full-stack developer from Aachen.`
const canonical = `https://devjakob.com/posts/${slug}`
const isoDate = date ? new Date(date).toISOString() : undefined

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: canonical,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
	...(isoDate ? { datePublished: isoDate } : {}),
	author: {
		'@type': 'Person',
		name: 'Jakob Pütz',
		url: 'https://devjakob.com',
	},
	publisher: {
		'@type': 'Person',
		name: 'Jakob Pütz',
		url: 'https://devjakob.com',
	},
	image: 'https://devjakob.com/assets/avatar.jpg',
	inLanguage: 'en',
}
---

<Layout
	title={`${title} · Jakob Pütz`}
	description={description}
	canonical={canonical}
	ogType="article"
	publishedTime={isoDate}
	schema={articleSchema}
>
	<TopBar width="72rem" />

	<div class="page">
		<div class="grid">
			<article class="article">
				<h1 class="title" data-enter style="--d:0">{title}</h1>
				<p class="date" data-enter style="--d:1">{formatted}</p>
				<PostStats slug={slug} readingMinutes={readingMinutes} />
				<div class="prose">
					{html ? <div set:html={html} /> : <slot />}
				</div>
			</article>

			<aside class="comments-aside">
				<Comments slug={slug} comments={comments} />
			</aside>
		</div>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		padding: 2.5rem 1.5rem 6rem;
	}

	.grid {
		width: 100%;
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3.5rem;
	}

	@media (min-width: 820px) {
		.grid {
			grid-template-columns: minmax(0, 1.85fr) minmax(0, 0.75fr);
			gap: 4rem;
			align-items: start;
		}
	}

	.article {
		width: 100%;
		min-width: 0;
	}

	.comments-aside {
		min-width: 0;
		max-width: 20rem;
	}

	.comments-aside :global(.comments) {
		margin-top: 0;
		width: 100%;
	}

	.title {
		font-size: 1.875rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--fg);
	}

	.date {
		font-size: 0.875rem;
		color: var(--fg-dim);
		margin-top: 0.5rem;
	}

	.prose {
		margin-top: 2.5rem;
	}

	.prose > :global(div) {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.prose :global(p) {
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--fg-muted);
		margin: 0;
	}

	.prose :global(p.md-gap) {
		padding: 0;
		min-height: 1.75em;
		pointer-events: none;
		user-select: none;
	}

	.prose :global(h2) {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--fg);
		margin: 0;
	}

	.prose :global(a:not(.file-card)) {
		position: relative;
		isolation: isolate;
		color: var(--fg);
		text-decoration: none;
	}

	.prose :global(a:not(.file-card))::after {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 66% -0.12em 0;
		background-color: var(--marker);
		transition:
			top var(--dur) var(--ease-marker),
			background-color var(--dur) var(--ease-out);
	}

	.prose :global(a:not(.file-card):hover)::after,
	.prose :global(a:not(.file-card):focus-visible)::after {
		top: 0;
		background-color: var(--marker-hover);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--fg-muted);
		margin: 0;
	}

	.prose :global(li + li) {
		margin-top: 0.35rem;
	}

	.prose :global(blockquote) {
		border-left: 2px solid var(--border);
		padding-left: 1rem;
		color: var(--fg-dim);
		font-style: italic;
	}

	.prose :global(code) {
		font-size: 0.9em;
		background: var(--btn-social-bg);
		padding: 0.1em 0.35em;
		border-radius: 0.25rem;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--border);
		background: var(--btn-social-bg);
	}

	.prose :global(pre code) {
		background: none;
		padding: 0;
	}

	.prose :global(img) {
		width: 100%;
		height: auto;
		border-radius: 1rem;
		display: block;
	}

	.prose :global(.file-card) {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		vertical-align: middle;
		color: var(--fg);
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		padding: 0.25em 0.6em;
		transition:
			border-color var(--dur) var(--ease-out),
			background-color var(--dur) var(--ease-out);
	}

	.prose :global(.file-card:hover) {
		border-color: var(--border-strong);
		background: var(--bg-elevated);
	}

	.prose :global(.file-card__dl) {
		width: 0.95em;
		height: 0.95em;
		flex-shrink: 0;
		opacity: 0.7;
		border-radius: 0;
		transition: transform var(--dur) var(--ease-out);
	}

	.prose :global(.file-card:hover .file-card__dl) {
		transform: translateY(1px);
	}
</style>
