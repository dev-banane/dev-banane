---
import Layout from './Layout.astro'
import PostStats from '../components/PostStats.astro'
import Comments from '../components/Comments.astro'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import type { Comment } from '../lib/comments'

interface Props {
	title: string
	date: string
	slug: string
	html?: string
	comments?: Comment[]
}

const { title, date, slug, html, comments = [] } = Astro.props
const formatted = new Date(date).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
})

function estimateReadingMinutes(content?: string): number {
	if (!content) return 1
	const text = content
		.replace(/<[^>]+>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim()
	const words = text ? text.split(' ').filter(Boolean).length : 0
	return Math.max(1, Math.round(words / 200))
}

const readingMinutes = estimateReadingMinutes(html)

function extractExcerpt(content?: string): string {
	if (!content) return ''
	const text = content
		.replace(/<[^>]+>/g, ' ')
		.replace(/&nbsp;/g, ' ')
		.replace(/&#(\d+);/g, (_, code: string) => String.fromCodePoint(Number(code)))
		.replace(/&quot;/g, '"')
		.replace(/&#x27;|&apos;/g, "'")
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&amp;/g, '&')
		.replace(/\s+/g, ' ')
		.trim()
	if (text.length <= 155) return text
	return `${text.slice(0, 155).replace(/\s+\S*$/, '')}…`
}

const excerpt = extractExcerpt(html)
const description = excerpt || `${title}, by Jakob Pütz, full-stack developer from Aachen.`
const canonical = `https://devjakob.com/posts/${slug}`
const isoDate = date ? new Date(date).toISOString() : undefined

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: canonical,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
	...(isoDate ? { datePublished: isoDate } : {}),
	author: {
		'@type': 'Person',
		name: 'Jakob Pütz',
		url: 'https://devjakob.com',
	},
	publisher: {
		'@type': 'Person',
		name: 'Jakob Pütz',
		url: 'https://devjakob.com',
	},
	image: 'https://devjakob.com/assets/avatar.jpg',
	inLanguage: 'en',
}
---

<Layout
	title={`${title} · Jakob Pütz`}
	description={description}
	canonical={canonical}
	ogType="article"
	publishedTime={isoDate}
	schema={articleSchema}
>
	<TopBar width="72rem" />

	<div class="page">
		<div class="grid">
			<article class="article">
				<h1 class="title" data-enter style="--d:0">{title}</h1>
				<p class="date" data-enter style="--d:1">{formatted}</p>
				<PostStats slug={slug} readingMinutes={readingMinutes} />
				<div class="prose">
					{html ? <div set:html={html} /> : <slot />}
				</div>

				<footer class="author" data-reveal>
					<img
						src="/assets/avatar.jpg"
						alt=""
						class="author__avatar"
						width="48"
						height="48"
						loading="lazy"
					/>
					<div class="author__text">
						<p class="author__name">Written by Jakob Pütz</p>
						<p class="author__bio">
							Full-stack developer in Aachen, building PFControl, Weavay and Petal.
						</p>
					</div>
					<div class="author__actions">
						<a href="#" class="btn btn--primary btn--sm" data-contact-link>Get in touch</a>
						<a href="/posts" class="btn btn--sm" data-astro-prefetch>More writing</a>
					</div>
				</footer>
			</article>

			<aside class="comments-aside">
				<Comments slug={slug} comments={comments} />
			</aside>
		</div>
	</div>

	<Footer width="72rem" />
</Layout>

<style>
	.page {
		min-height: 100vh;
		padding: 2.5rem 1.5rem 5rem;
	}

	.grid {
		width: 100%;
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3.5rem;
	}

	@media (min-width: 820px) {
		.grid {
			grid-template-columns: minmax(0, 1.85fr) minmax(0, 0.75fr);
			gap: 4rem;
			align-items: start;
		}
	}

	.article {
		width: 100%;
		min-width: 0;
	}

	.comments-aside {
		min-width: 0;
		max-width: 20rem;
	}

	.comments-aside :global(.comments) {
		margin-top: 0;
		width: 100%;
	}

	.title {
		font-size: clamp(1.875rem, 4vw, 2.375rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--fg);
	}

	.author {
		margin-top: 4rem;
		padding: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: var(--bg-elevated);
	}

	.author__avatar {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		border: 1px solid var(--border);
	}

	.author__text {
		flex: 1 1 14rem;
		min-width: 0;
	}

	.author__name {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--fg);
	}

	.author__bio {
		margin-top: 0.2rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--fg-muted);
	}

	.author__actions {
		display: flex;
		gap: 0.5rem;
	}

	.date {
		font-size: 0.875rem;
		color: var(--fg-dim);
		margin-top: 0.5rem;
	}

	.prose {
		margin-top: 2.5rem;
	}

	.prose > :global(div) {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.prose :global(p),
	.prose :global(li) {
		text-align: justify;
		hyphens: auto;
		-webkit-hyphens: auto;
	}

	.prose :global(p) {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--fg-muted);
		margin: 0;
	}

	.prose :global(p.md-gap) {
		padding: 0;
		min-height: 1.75em;
		pointer-events: none;
		user-select: none;
	}

	.prose :global(strong) {
		font-weight: 600;
		color: var(--fg);
	}

	.prose :global(.md-heading) {
		position: relative;
		margin: 0;
		color: var(--fg);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.3;
		scroll-margin-top: 2rem;
		text-wrap: balance;
	}

	.prose :global(h2.md-heading) {
		margin-top: 1.5rem;
		font-size: 1.4375rem;
	}

	.prose :global(h3.md-heading) {
		margin-top: 0.75rem;
		font-size: 1.1875rem;
	}

	.prose :global(h4.md-heading) {
		font-size: 1rem;
	}

	.prose :global(.md-anchor) {
		position: absolute;
		right: 100%;
		padding-right: 0.4em;
		color: var(--fg-dim);
		font-weight: 500;
		text-decoration: none;
		opacity: 0;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.prose :global(.md-heading:hover .md-anchor),
	.prose :global(.md-anchor:focus-visible) {
		opacity: 1;
	}

	.prose :global(a:not(.file-card):not(.md-anchor)) {
		position: relative;
		isolation: isolate;
		color: var(--fg);
		text-decoration: none;
	}

	.prose :global(a:not(.file-card):not(.md-anchor))::after {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 66% -0.12em 0;
		background-color: var(--marker);
		transition:
			top var(--dur) var(--ease-marker),
			background-color var(--dur) var(--ease-out);
	}

	.prose :global(a:not(.file-card):not(.md-anchor):hover)::after,
	.prose :global(a:not(.file-card):not(.md-anchor):focus-visible)::after {
		top: 0;
		background-color: var(--marker-hover);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0;
		padding-left: 1.4rem;
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--fg-muted);
	}

	.prose :global(li + li) {
		margin-top: 0.4rem;
	}

	.prose :global(li::marker) {
		color: var(--fg-dim);
	}

	.prose :global(ol > li::marker) {
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}

	.prose :global(blockquote) {
		margin: 0;
		padding: 1rem 1.25rem;
		border-left: 3px solid var(--accent);
		border-radius: 0.25rem 0.9rem 0.9rem 0.25rem;
		background: var(--glass-bg);
		box-shadow: var(--glass-shadow);
	}

	.prose :global(blockquote p) {
		color: var(--fg);
	}

	.prose :global(blockquote > * + *) {
		margin-top: 0.75rem;
	}

	.prose :global(:not(pre) > code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.85em;
		padding: 0.12em 0.4em;
		border-radius: 0.375rem;
		color: var(--fg);
		background: var(--glass-bg);
		box-shadow: 0 0 0 1px var(--border);
		overflow-wrap: anywhere;
	}

	.prose :global(.code-block) {
		margin: 0.25rem 0;
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--bg-elevated);
		box-shadow:
			0 0 0 1px var(--border),
			0 8px 24px -16px rgba(0, 0, 0, 0.5);
	}

	.prose :global(.code-block__bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0.45rem 0.4rem 1rem;
		border-bottom: 1px solid var(--border);
	}

	.prose :global(.code-block__lang) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		color: var(--fg-dim);
	}

	.prose :global(.code-block__copy) {
		height: 1.75rem;
		font-size: 0.75rem;
	}

	.prose :global(.code-block pre) {
		margin: 0;
		padding: 1rem 1.1rem;
		overflow-x: auto;
		background: none;
		border: none;
	}

	.prose :global(.code-block code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--fg);
		text-align: left;
	}

	.prose :global(img) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0.9rem;
		box-shadow: 0 0 0 1px var(--border);
	}

	.prose :global(.md-table) {
		overflow-x: auto;
		border-radius: 0.9rem;
		box-shadow: 0 0 0 1px var(--border);
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}

	.prose :global(th) {
		padding: 0.65rem 1rem;
		text-align: left;
		font-weight: 600;
		color: var(--fg);
		background: var(--glass-bg);
	}

	.prose :global(td) {
		padding: 0.65rem 1rem;
		border-top: 1px solid var(--border);
		color: var(--fg-muted);
	}

	.prose :global(hr) {
		height: 1px;
		margin: 1rem 0;
		border: 0;
		background: var(--border);
	}

	.prose :global(.file-card) {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		vertical-align: middle;
		color: var(--fg);
		padding: 0.25em 0.7em;
		border-radius: 9999px;
		background: var(--glass-bg);
		box-shadow: var(--glass-shadow);
		transition: background-color var(--dur-fast) var(--ease-out);
	}

	.prose :global(.file-card:hover) {
		background: var(--glass-bg-hover);
	}

	.prose :global(.file-card__dl) {
		width: 0.95em;
		height: 0.95em;
		flex-shrink: 0;
		opacity: 0.7;
		border-radius: 0;
		box-shadow: none;
		transition: transform var(--dur) var(--ease-out);
	}

	.prose :global(.file-card:hover .file-card__dl) {
		transform: translateY(1px);
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLButtonElement>('.code-block__copy').forEach((button) => {
			button.addEventListener('click', async () => {
				const code = button.closest('.code-block')?.querySelector('code')?.textContent ?? ''
				try {
					await navigator.clipboard.writeText(code)
					button.textContent = 'Copied'
				} catch {
					button.textContent = 'Press Ctrl+C'
				}
				window.setTimeout(() => (button.textContent = 'Copy'), 1500)
			})
		})
	})
</script>
