---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import ContactModal from '../components/ContactModal.astro'

interface Props {
	title?: string
	description?: string
	canonical?: string
	ogImage?: string
	ogType?: 'website' | 'article'
	publishedTime?: string
	schema?: Record<string, unknown>
	noindex?: boolean
}

const {
	title = 'Jakob Pütz',
	description = 'Jakob Pütz (also known as Jakob Puetz or devjakob), 17-year-old full-stack developer from Aachen, Germany. Building Weavay, Petal and PFControl. TypeScript, Next.js, Postgres.',
	canonical = 'https://devjakob.com',
	ogImage = 'https://devjakob.com/og.png',
	ogType = 'website',
	publishedTime,
	schema,
	noindex = false,
} = Astro.props

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Jakob Pütz',
	alternateName: ['Jakob Puetz', 'devjakob', 'dev-banane', 'devbanane', 'jakob dev'],
	url: 'https://devjakob.com',
	image: 'https://devjakob.com/assets/avatar.jpg',
	jobTitle: 'Full-Stack Developer',
	description: 'Full-stack developer from Aachen, Germany. Building Weavay, Petal and PFControl.',
	knowsAbout: [
		'TypeScript',
		'Next.js',
		'PostgreSQL',
		'Cloudflare Workers',
		'Software Engineering',
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Aachen',
		addressCountry: 'DE',
	},
	sameAs: [
		'https://github.com/dev-banane',
		'https://x.com/devbanane',
		'https://www.linkedin.com/in/jakobpuetz',
	],
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Jakob Pütz" />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		<meta id="theme-color-meta" name="theme-color" content="#ffffff" />

		<meta property="og:type" content={ogType} />
		{
			ogType === 'article' && publishedTime && (
				<meta property="article:published_time" content={publishedTime} />
			)
		}
		{ogType === 'article' && <meta property="article:author" content="Jakob Pütz" />}
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content="Jakob Pütz" />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@devbanane" />
		<meta name="twitter:creator" content="@devbanane" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="canonical" href={canonical} />
		<link rel="me" href="https://github.com/dev-banane" />
		<link rel="me" href="https://x.com/devbanane" />
		<link rel="me" href="https://www.linkedin.com/in/jakobpuetz" />

		<link rel="llms" href="https://devjakob.com/llms.txt" type="text/plain" />
		<meta name="llms" content="https://devjakob.com/llms.txt" />

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
		<script is:inline src="/theme-init.js"></script>
		<script is:inline src="/theme-swap.js"></script>
	</head>
	<body>
		<slot />
		<ContactModal />

		<script>
			let revealObserver: IntersectionObserver | null = null
			let pendingHash = ''

			document.addEventListener('astro:before-swap', (event) => {
				const e = event as Event & {
					newDocument: Document
					navigationType: string
					to: URL
				}
				e.newDocument.documentElement.classList.add('js', 'no-enter')
				pendingHash = e.navigationType === 'traverse' ? '' : e.to.hash
			})

			document.addEventListener('astro:after-swap', () => {
				const hash = pendingHash
				pendingHash = ''
				if (!hash) return
				const id = decodeURIComponent(hash.slice(1))
				if (!id) return
				document.getElementById(id)?.scrollIntoView({ block: 'start', behavior: 'auto' })
			})

			function initReveal() {
				revealObserver?.disconnect()

				const targets = document.querySelectorAll<HTMLElement>('[data-reveal]')
				if (!targets.length) return

				if (
					!('IntersectionObserver' in window) ||
					window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
					document.documentElement.classList.contains('no-enter')
				) {
					targets.forEach((el) => el.classList.add('is-revealed'))
					return
				}

				revealObserver = new IntersectionObserver(
					(entries, observer) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue
							entry.target.classList.add('is-revealed')
							observer.unobserve(entry.target)
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
				)

				targets.forEach((el) => revealObserver!.observe(el))
			}

			document.addEventListener('astro:page-load', initReveal)

			// Assembled at runtime so the address never sits in the HTML for scrapers.
			const ADDRESS = `${'me'}@${'devjakob.com'}`

			document.addEventListener('astro:page-load', () => {
				// Real mailto for middle-click, "copy link" and anyone without the modal.
				document
					.querySelectorAll<HTMLAnchorElement>('a[data-contact-link]')
					.forEach((link) => (link.href = `mailto:${ADDRESS}`))
				const address = document.querySelector('[data-compose-address]')
				if (address) address.textContent = ADDRESS
			})

			function composeDialog() {
				return document.getElementById('contact-modal') as HTMLDialogElement | null
			}

			// Delegated on document: page swaps replace <body>, the listeners survive.
			document.addEventListener('click', (event) => {
				const target = event.target as Element | null
				if (!target?.closest) return
				const dialog = composeDialog()

				const link = target.closest('a[data-contact-link]')
				if (link) {
					const e = event as MouseEvent
					if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
					if (!dialog || typeof dialog.showModal !== 'function') return
					event.preventDefault()
					dialog.showModal()
					const empty = [...dialog.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
						'input, textarea'
					)].find((field) => !field.value)
					;(empty ?? dialog.querySelector('textarea'))?.focus()
					return
				}

				if (!dialog?.open) return
				if (target === dialog || target.closest('[data-compose-close]')) {
					dialog.close()
					return
				}

				const copy = target.closest('[data-compose-copy]')
				if (copy) {
					const label = copy.querySelector('[data-compose-copy-label]')
					navigator.clipboard
						?.writeText(ADDRESS)
						.then(() => {
							if (!label) return
							label.textContent = 'Copied!'
							window.setTimeout(() => (label.textContent = 'Copy address'), 1500)
						})
						.catch(() => {})
				}
			})

			document.addEventListener('submit', (event) => {
				const form = event.target as HTMLFormElement | null
				if (form?.id !== 'compose-form') return
				event.preventDefault()
				const data = new FormData(form)
				const from = String(data.get('from') ?? '').trim()
				const subject = String(data.get('subject') ?? '').trim() || 'Hello from devjakob.com'
				let body = String(data.get('message') ?? '').trim()
				if (from) body += `\n\n${from}`
				window.location.href =
					`mailto:${ADDRESS}?subject=${encodeURIComponent(subject)}` +
					`&body=${encodeURIComponent(body)}`
				window.setTimeout(() => {
					composeDialog()?.close()
					form.reset()
				}, 400)
			})
		</script>

		<script>
			import { dizzy, pick, quip } from '../lib/fun'

			const DIZZY = ['make up your mind', 'I’m getting dizzy', 'light? dark? both?', 'pls stop']
			let spamClicks: number[] = []

			document.addEventListener('astro:page-load', () => {
				const toggle = document.getElementById('theme-toggle')
				if (!toggle) return

				const fresh = toggle.cloneNode(true) as Element
				toggle.replaceWith(fresh)

				function current() {
					return document.documentElement.getAttribute('data-theme') ?? 'light'
				}
				fresh.setAttribute('aria-checked', String(current() === 'dark'))

				let transitioning = false

				fresh.addEventListener('click', () => {
					const now = performance.now()
					spamClicks = [...spamClicks.filter((t) => now - t < 4000), now]
					if (spamClicks.length >= 5) {
						spamClicks = []
						dizzy(fresh)
						quip(fresh, pick(DIZZY), { fall: true })
					}

					if (transitioning) return

					const next = current() === 'dark' ? 'light' : 'dark'
					const applyNext = () => {
						localStorage.setItem('theme', next)
						;(
							window as Window & { __applyTheme?: (theme: string) => void }
						).__applyTheme?.(next)
						fresh.setAttribute('aria-checked', String(next === 'dark'))
					}

					const reduceMotion = window.matchMedia(
						'(prefers-reduced-motion: reduce)'
					).matches
					const supportsViewTransition = 'startViewTransition' in document

					if (reduceMotion || !supportsViewTransition) {
						applyNext()
						return
					}

					const root = document.documentElement
					root.classList.add('theme-vt')
					transitioning = true
					try {
						const transition = (
							document as Document & {
								startViewTransition: (cb: () => void) => {
									ready: Promise<void>
									finished: Promise<void>
								}
							}
						).startViewTransition(applyNext)

						transition.finished.finally(() => {
							root.classList.remove('theme-vt')
							transitioning = false
						})

						const rect = fresh.getBoundingClientRect()
						const x = rect.left + rect.width / 2
						const y = rect.top + rect.height / 2
						const endRadius = Math.hypot(
							Math.max(x, window.innerWidth - x),
							Math.max(y, window.innerHeight - y)
						)

						transition.ready.then(() => {
							root.animate(
								{
									clipPath: [
										`circle(0px at ${x}px ${y}px)`,
										`circle(${endRadius}px at ${x}px ${y}px)`,
									],
								},
								{
									duration: 650,
									easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
									pseudoElement: '::view-transition-new(root)',
								}
							)
						})
					} catch {
						root.classList.remove('theme-vt')
						transitioning = false
						applyNext()
					}
				})
			})
		</script>
	</body>
</html>
